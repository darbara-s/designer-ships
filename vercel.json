{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "fahrly/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/fahrly/(.*)",
      "dest": "/fahrly/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
